# Dev-only values. Copy to .env and change for anything non-local.
# docker compose reads POSTGRES_* from .env automatically (defaults below apply if absent).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=retail

# Used by the app and Alembic when running outside Docker (export it in your shell).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/retail
